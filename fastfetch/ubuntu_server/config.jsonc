{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "command-raw",
        "source": "ssh-keygen -lv -f /etc/ssh/ssh_host_ed25519_key.pub | tail -n +2",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{#32}{user-name}{#default}@{#32}{host-name}"
        },
        {
            "type": "os",
            "key": "os    ",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "kernel",
            "keyColor": "red"
        },
        {
            "type": "packages",
            "key": "pkgs  ",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "text": "cat /var/lib/misc/updates-available 2>/dev/null || echo '?'",
            "key": "update",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "text": "[ -f /var/run/reboot-required ] && echo required || echo no",
            "key": "reboot",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "format": "{?days}{days}d {?}{hours}h {minutes}m",
            "key": "uptime",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "memory",
            "keyColor": "cyan"
        },
        {
            "type": "disk",
            "folders": "/",
            "key": "disk  ",
            "keyColor": "cyan"
        },
        {
            "type": "localip",
            "showIpv6": false,
            "key": "ip    ",
            "keyColor": "green"
        },
        {
            "type": "command",
            "text": "docker ps -q 2>/dev/null | wc -l",
            "key": "docker",
            "keyColor": "blue"
        },
        "break"
    ]
}
