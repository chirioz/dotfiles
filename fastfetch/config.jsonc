{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "command-raw",
        "source": "ssh-keygen -lv -f ~/.ssh/id_ed25519.pub | tail -n +2",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "brightColor": false
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{#32}{user-name}{#default}@{#32}{host-name}"
        },
        {
            "type": "os",
            "key": "os    ",
            "keyColor": "38;5;7"
        },
        {
            "type": "kernel",
            "key": "kernel",
            "keyColor": "38;5;6"
        },
        {
            "type": "packages",
            "key": "pkgs  ",
            "keyColor": "38;5;6"
        },
        {
            "type": "uptime",
            "format": "{?days}{days}d {?}{hours}h {minutes}m",
            "key": "uptime",
            "keyColor": "38;5;1"
        },
        {
            "type": "memory",
            "key": "memory",
            "keyColor": "38;5;3"
        },
        {
            "type": "disk",
            "folders": "/",
            "key": "disk  ",
            "keyColor": "38;5;5"
        },
        {
            "type": "localip",
            "showIpv6": false,
            "defaultRouteOnly": true,
            "key": "ip    ",
            "keyColor": "38;5;5"
        },
        {
            "type": "battery",
            "key": "bat   ",
            "keyColor": "38;5;4"
        },
        {
            "type": "shell",
            "key": "shell ",
            "keyColor": "38;5;4"
        },
        {
            "type": "terminal",
            "key": "term  ",
            "keyColor": "38;5;4"
        },
        "break"
    ]
}
